# Copy to .env (git-ignored) and fill in your real values:  cp .env.example .env
#
# This project reads ITS secrets from this .env via `secretspec run --provider dotenv`,
# so it does NOT touch your global ~/.config/secretspec provider or any other project.
# One file holds the secrets (read by secretspec) AND the non-secret RESEARCHER_* config
# (forwarded into the microVM by the sandbox app). Fill what you have; blank RESEARCHER_*
# keys fall back to the defaults shown.

# ===================== secrets (secretspec) =====================
# Zulip bot
ZULIP_URL=https://zulip.example.com
ZULIP_API_KEY=
ZULIP_API_USERNAME=research-bot@example.com

# Preparation interface (prepare-markdown Worker) — normalizes operator text
PREPARE_URL=https://prepare.example.com
PREPARE_TOKEN=

# omp model provider (set what your model needs)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.example.com/v1
# ANTHROPIC_API_KEY=

# Web search is KEYLESS by default (omp falls back to DuckDuckGo & other free engines).
# Set ONE of these only if you want a more reliable/keyed provider (optional):
# BRAVE_API_KEY=
# TAVILY_API_KEY=

# GitHub push. PUSH_TOKEN is the default; the per-target tokens below override it (each
# falls back to PUSH_TOKEN if unset) — use separate ones when the repos have different
# owners/scopes.
PUSH_TOKEN=
# WIKI_PUSH_TOKEN=              # the wiki repo (research PRs)
# BLUESKY_OPERATOR_PUSH_TOKEN=  # your Bluesky repo
# BLUESKY_AGENT_PUSH_TOKEN=     # the agent's Bluesky repo

# ================ non-secret config (RESEARCHER_*) ================
# omp
RESEARCHER_OMP_MODEL=

# who / where
RESEARCHER_OPERATOR_EMAIL=you@example.com
# If your org hides email addresses (GET users/<email> -> "No such user"), set your
# numeric Zulip user id here instead; it takes precedence over the email.
RESEARCHER_OPERATOR_ID=
RESEARCHER_STREAM=research
RESEARCHER_MENTION_NAME=research
RESEARCHER_GENERAL_TOPIC=general

# preparation policy/format (defaults are usually fine)
RESEARCHER_PREPARE_POLICY=faithful-en-v1
RESEARCHER_PREPARE_FORMAT=markdown

# wiki (Research -> pages via PR)
RESEARCHER_WIKI_REPO_URL=https://github.com/you/your-wiki.git
RESEARCHER_WIKI_SITE_URL=https://wiki.example.com
RESEARCHER_WIKI_BASE_BRANCH=main
RESEARCHER_WIKI_PAGES_SUBDIR=site
# RESEARCHER_WIKI_CLONE_DIR=/tmp/wiki        # default inside the VM

# Bluesky producer (mirror -> two repos)
RESEARCHER_BLUESKY_OPERATOR_REPO_URL=https://github.com/you/your-bluesky-operator.git
RESEARCHER_BLUESKY_AGENT_REPO_URL=https://github.com/you/your-bluesky-agent.git
RESEARCHER_BLUESKY_BRANCH=main
RESEARCHER_BLUESKY_POSTS_SUBDIR=posts
# RESEARCHER_BLUESKY_CLONE_DIR=/tmp/bluesky  # default inside the VM

# git identity for the commits the agent makes
RESEARCHER_GIT_USER_NAME=research agent
RESEARCHER_GIT_USER_EMAIL=agent@example.com

# behaviour
RESEARCHER_POLL_INTERVAL=60
RESEARCHER_WIKI_READY_TIMEOUT=600
RESEARCHER_WIKI_READY_INTERVAL=10
